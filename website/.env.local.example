# Copy this file to .env.local (same folder). /landing-page fills it in for you.
# Next.js only reads env files inside website/, which is why these live here and not in the
# project-root .env. When the site goes live, /publish adds the same four to the Vercel project.
# .env.local is gitignored. Never commit it.

# Where every form and every click-to-call is sent. Server-side only, never shown to a visitor.
# GoHighLevel: Automation > new workflow > trigger "Inbound Webhook" > copy the URL.
LEAD_WEBHOOK_URL=

# The Google tag, AW-XXXXXXXXX. Google Ads > Tools > Data manager > Google tag.
NEXT_PUBLIC_GADS_ID=

# The conversion labels: the part after the slash in "send_to: AW-XXXXXXXXX/abcDEF123".
# python3 code/check_conversion_setup.py prints both.
NEXT_PUBLIC_GADS_FORM_LABEL=
NEXT_PUBLIC_GADS_CALL_LABEL=
