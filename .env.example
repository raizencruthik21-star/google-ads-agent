# Copy this file to .env. The commands fill it in for you, one value at a time, the first time
# each one is needed - /api-setup writes the Google Ads lines.
# .env is gitignored. NEVER commit it, and never paste one of these values into a chat or a page.
# No developer token: Google retired them on 10 September 2026. The access level comes from the Cloud
# project behind the OAuth client. An old GOOGLE_ADS_DEVELOPER_TOKEN line can stay; it is ignored.

# Google Ads API - written by /api-setup from your credentials.json and your sign-in.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=          # the account running the ads, 10 digits, no dashes - python3 code/list_accounts.py shows them
GOOGLE_ADS_LOGIN_CUSTOMER_ID=    # a manager account ID, ONLY if you reach the ads account through one - blank otherwise

# Your business.
BUSINESS_NAME=
SITE_BASE_URL=                   # your live home page, https://yourdomain.com - ads point here until their landing page is live

# Your market. COUNTRY is the two-letter code customers search from (US, CA, GB, AU, NZ, IE).
# MAIN_CITY is the ONE city the ads name when Google cannot place the searcher - the fallback in every
# pinned headline and landing page headline. Write none for a remote or national business.
COUNTRY=
MAIN_CITY=

# Where leads go. /write-ads and /landing-page ask for these.
LEAD_WEBHOOK_URL=                # your CRM's inbound webhook - in GoHighLevel: Automation > new workflow > trigger "Inbound Webhook"
BUSINESS_PHONE=                  # the one real number, no pools, written the same way everywhere

# The Google tag ID, AW-XXXXXXXXX. Google Ads > Tools > Data manager > Google tag.
GOOGLE_TAG_ID=

# Ad assets (/write-ads, code/push_assets.py). The script names whatever is missing.
BUSINESS_NAME_ASSET=             # the business-name asset: your VERIFIED domain root or legal entity
LOGO_PATH=                       # square PNG or JPG, 1200x1200, for the logo asset - never generated without your yes
PRIVACY_POLICY_URL=              # the lead form's privacy policy link, https://yourdomain.com/privacy-policy
LEAD_WEBHOOK_SECRET=             # the lead form's webhook key, from the same inbound webhook
MESSAGE_NUMBER=                  # the number that receives message-asset replies - falls back to BUSINESS_PHONE

# Optional: stock photos for /build-website (code/fetch_photos.py). Free: unsplash.com/oauth/applications/new
UNSPLASH_ACCESS_KEY=

# Optional: Lighthouse page speed in /audit (code/psi_speed.py, called by cro_score.py). Free.
# console.cloud.google.com > APIs & Services > enable "PageSpeed Insights API" > Credentials > API key. Skipped when blank.
PAGESPEED_API_KEY=
